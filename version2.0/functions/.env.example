# ---------------------------------------------------------------------------
# Cloud Functions secrets — server-side only, never exposed to the browser.
# Copy this file to `.env` in this folder (version2.0/functions/) and fill in
# your own values. Create the webhook URLs in Discord:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
#
# Keep the real `.env` private — these webhook URLs are write credentials for
# your Discord channels and should be rotated if ever leaked.
# ---------------------------------------------------------------------------

# Public image URL used as the avatar on the Discord notifications.
DISCORD_WEBHOOK_AVATAR_URL="https://example.com/avatar.png"

# Webhook that receives new site-visit notifications (IP + geo).
DISCORD_CHANNEL_WEBHOOK_VISITS="https://discord.com/api/webhooks/000000000000000000/your-visits-webhook-token"

# Webhook that receives new contact-form messages (email + body).
DISCORD_CHANNEL_WEBHOOK_MESSAGES="https://discord.com/api/webhooks/000000000000000000/your-messages-webhook-token"
