# ---------------------------------------------------------------------------
# Firebase client config (Vite).
# Copy this file to `.env` in this folder and fill in your own values from:
#   Firebase console -> Project settings -> General -> "Your apps" -> SDK setup.
#
# These VITE_* vars are bundled into the client at build time, so they are
# public by design. The real `.env` is still gitignored to keep project-
# specific config out of version control.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# ---------------------------------------------------------------------------
# Optional: legacy v1 ("old site") Firebase project.
# Not read by the current version2.0 code (the link to the old site is
# hardcoded), so leave these commented out unless you wire the old project
# back up.
# ---------------------------------------------------------------------------

# VITE_OLD_FIREBASE_API_KEY="your-old-firebase-api-key"
# VITE_OLD_FIREBASE_AUTH_DOMAIN="your-old-project.firebaseapp.com"
# VITE_OLD_FIREBASE_PROJECT_ID="your-old-project-id"
# VITE_OLD_FIREBASE_STORAGE_BUCKET="your-old-project.firebasestorage.app"
# VITE_OLD_FIREBASE_MESSAGING_SENDER_ID="000000000000"
# VITE_OLD_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
